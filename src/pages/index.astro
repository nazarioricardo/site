---
import Welcome from "../components/Welcome.astro";
import Layout from "../layouts/Layout.astro";
import XPWindow from "../components/XPWindow.astro";
import XPButton from "../components/XPButton.astro";
import email from "../assets/email.png";
// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
    <!-- <Welcome /> -->
    <XPWindow width='100%"' menubar={[]} titlebar="header">
        <div class="p-3">
            <div class="flex flex-row items-center gap-2">
                <button
                    type="button"
                    id="copy-email-btn"
                    data-email="nazarioricardo@gmail.com"
                    class="flex flex-row items-center gap-2 w-1/2 bg-white hover:cursor-pointer hover:bg-[#0058ee] hover:text-white pr-4"
                >
                    <img src={email.src} alt="email" class="h-20" />
                    <div class="flex flex-col text-left">
                        <span class="font-bold">Email</span>
                        <span class="font-light">
                            nazarioricardo@gmail.com
                        </span>
                    </div>
                    <span
                        class="text-white ml-auto text-xs"
                        id="copy-email-label"
                    >
                        Copy to Clipboard
                    </span>
                </button>
            </div>
        </div>
        <div class="flex flex-col flex-1 justify-between bg-[#ece9d8] p-4">
            <div>
                <p class="mb-4">
                    Hello. I'm a software developer. I love making products that
                    make life a little nicer for their users.
                </p>

                <p class="mb-4">
                    I've worked as a full stack and mobile developer for the
                    past 6 years, making products in the music, medical, and
                    energy industries.
                </p>
            </div>
            <a
                class="flex flex-row w-full justify-end"
                href="/RicardoNazario_Resume.pdf"
                target="_blank"
            >
                <XPButton label="Download CV" />
            </a>
        </div>
    </XPWindow>
</Layout>

<script>
    const btn = document.getElementById("copy-email-btn");
    const label = document.getElementById("copy-email-label");

    btn?.addEventListener("click", async () => {
        const email = btn.dataset.email;
        if (!email) return;

        try {
            await navigator.clipboard.writeText(email);
            if (label) {
                const original = label.textContent;
                label.textContent = "Copied!";
                setTimeout(() => {
                    label.textContent = original;
                }, 1500);
            }
        } catch (err) {
            console.error("Copy failed", err);
        }
    });
</script>
