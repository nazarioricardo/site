---
import Layout from "../layouts/Layout.astro";
import XPWindow from "../components/XPWindow.astro";
import XPButton from "../components/XPButton.astro";
import email from "../assets/email.png";
import { getCollection, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { slugify } from "../utils/slugify";

const projects: CollectionEntry<"projects">[] = await getCollection("projects");
---

<Layout>
    <!-- <Welcome /> -->
    <div class="h-16"></div>

    <XPWindow class="w-2/3" menubar={[]} titlebar="header">
        <div class="p-3">
            <div class="flex flex-row items-center gap-2">
                <button
                    type="button"
                    id="copy-email-btn"
                    data-email="nazarioricardo@gmail.com"
                    class="flex flex-row items-center gap-2 w-1/2 bg-white hover:cursor-pointer hover:bg-[#0058ee] hover:text-white pr-4"
                >
                    <img src={email.src} alt="email" class="h-20" />
                    <div class="flex flex-col text-left">
                        <span class="font-bold">Email</span>
                        <span class="font-light">
                            nazarioricardo@gmail.com
                        </span>
                    </div>
                    <span
                        class="text-white ml-auto text-xs"
                        id="copy-email-label"
                    >
                        Copy to Clipboard
                    </span>
                </button>
            </div>
        </div>
        <div class="flex flex-col flex-1 justify-between bg-[#ece9d8] p-4">
            <div>
                <div class="mb-4">
                    <ul class="flex flex-row gap-2 font-semibold">
                        <li>
                            <a
                                class="hover:underline"
                                href="https://github.com/nazarioricardo/"
                                target="_blank"
                            >
                                Github
                            </a>
                        </li>
                        <span>•</span>

                        <li>
                            <a
                                class="hover:underline"
                                href="https://www.linkedin.com/in/nazarioricardo/"
                                target="_blank"
                            >
                                LinkedIn
                            </a>
                        </li>
                        <span>•</span>

                        <li>
                            <a
                                class="hover:underline"
                                href="https://www.instagram.com/ricardo.nw/"
                                target="_blank"
                            >
                                Instagram
                            </a>
                        </li>
                    </ul>
                </div>
                <div>
                    <p class="mb-4">
                        Hello. I'm a software developer. I love making products
                        that make life a little nicer for their users.
                    </p>

                    <p class="mb-4">
                        I've worked as a full stack and mobile developer for the
                        past 6 years, making products in the music, medical, and
                        energy industries.
                    </p>
                </div>
            </div>
            <div class="flex flex-row w-full justify-end items-end">
                <a href="/RicardoNazario_Resume.pdf" target="_blank">
                    <XPButton label="Download CV" />
                </a>
            </div>
        </div>
    </XPWindow>

    <h2 class="text-2xl font-semibold mb-4 pt-5">Projects</h2>
    <ul>
        {
            projects.map((project) => (
                <li>
                    <a
                        href={`/projects/${slugify(project.data.title)}`}
                        class="flex flex-row gap-3 mb-4 hover:opacity-80 group"
                    >
                        <Image
                            src={project.data.thumbnail}
                            alt={project.data.title}
                            width={100}
                        />
                        <div class="flex flex-col">
                            <h3 class="text-xl font-semibold group-hover:underline group-focus:underline underline-offset-2">
                                {project.data.title}
                            </h3>
                            <p class="group-hover:underline group-focus:underline underline-offset-2">
                                {project.data.description}
                            </p>
                        </div>
                    </a>
                </li>
            ))
        }
    </ul>
</Layout>

<script>
    const btn = document.getElementById("copy-email-btn");
    const label = document.getElementById("copy-email-label");

    btn?.addEventListener("click", async () => {
        const email = btn.dataset.email;
        if (!email) return;

        try {
            await navigator.clipboard.writeText(email);
            if (label) {
                const original = label.textContent;
                label.textContent = "Copied!";
                setTimeout(() => {
                    label.textContent = original;
                }, 1500);
            }
        } catch (err) {
            console.error("Copy failed", err);
        }
    });
</script>
