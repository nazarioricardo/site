---
import Titlebar from "./Titlebar.astro";
import Headerbar from "./Headerbar.astro";
import Menubar from "./Menubar.astro";
import Resize from "./Resize.astro";

export interface Props {
    title?: string;
    width?: string; // any CSS width value, e.g. "500px", "40rem", "90%"
    menubar?: string[];
    titlebar?: "default" | "header";
}
const {
    title = "My Computer",
    width = "500px",
    menubar = ["File", "Edit", "View", "Favorites", "Tools", "Help"],
    titlebar = "default",
} = Astro.props;
---

<div
    class={`xp-window
    flex flex-col
    font-[Tahoma,Verdana,sans-serif] text-[13px]
    overflow-hidden
    select-none
    ${titlebar === "header" ? "rounded-t-xl" : "rounded-t-lg"}
    `}
    style={`width: ${width}; position: relative; display: flex; flex-direction: column;`}
>
    {titlebar === "header" ? <Headerbar /> : <Titlebar title={title} />}
    <div
        class="border-2 border-t-0 border-[#2178E0] flex flex-col flex-1 min-h-0"
    >
        {menubar.length > 0 && <Menubar items={menubar} />}

        <!-- Body -->
        <div
            class="bg-white flex-1 overflow-auto border-t border-[#f4f2e8] flex flex-col min-h-0"
        >
            <slot>
                <p class="text-gray-700">Window content goes here.</p>
            </slot>
        </div>

        <!-- Status bar -->
        {
            titlebar === "default" ? (
                <div class="h-6 bg-[#ece9d8] border-t border-[#aca899] flex items-center px-2 text-[11px] text-gray-600">
                    <slot name="status">Ready</slot>
                </div>
            ) : null
        }

        <Resize />
    </div>
</div>

<script>
    function initDrag(win: HTMLElement) {
        const bar = win.querySelector<HTMLElement>(".xp-titlebar");
        if (!bar || win.dataset.dragInit) return;
        win.dataset.dragInit = "true";

        let dragging = false;
        let offsetX = 0;
        let offsetY = 0;

        bar.addEventListener("mousedown", (e) => {
            dragging = true;
            const rect = win.getBoundingClientRect();
            offsetX = e.clientX - rect.left;
            offsetY = e.clientY - rect.top;
            win.style.position = "fixed";
            win.style.margin = "0";
            win.style.left = `${rect.left}px`;
            win.style.top = `${rect.top}px`;
            win.style.zIndex = "1000";
            e.preventDefault();
        });

        window.addEventListener("mousemove", (e) => {
            if (!dragging) return;
            win.style.left = `${e.clientX - offsetX}px`;
            win.style.top = `${e.clientY - offsetY}px`;
        });

        window.addEventListener("mouseup", () => {
            dragging = false;
        });
    }

    function initResize(win: HTMLElement) {
        const handles = win.querySelectorAll<HTMLElement>(".xp-resize");
        if (!handles.length || win.dataset.resizeInit) return;
        win.dataset.resizeInit = "true";

        let dir = "";
        let resizing = false;
        let startX = 0,
            startY = 0;
        let startWidth = 0,
            startHeight = 0;
        let startLeft = 0,
            startTop = 0;

        handles.forEach((handle) => {
            handle.addEventListener("mousedown", (e) => {
                resizing = true;
                dir = handle.dataset.dir || "";
                const rect = win.getBoundingClientRect();
                startX = e.clientX;
                startY = e.clientY;
                startWidth = rect.width;
                startHeight = rect.height;
                startLeft = rect.left;
                startTop = rect.top;

                // ensure fixed positioning so left/top edits work (same as drag)
                win.style.position = "fixed";
                win.style.margin = "0";
                win.style.left = `${startLeft}px`;
                win.style.top = `${startTop}px`;
                win.style.zIndex = "1000";

                e.preventDefault();
                e.stopPropagation();
            });
        });

        window.addEventListener("mousemove", (e) => {
            if (!resizing) return;
            const dx = e.clientX - startX;
            const dy = e.clientY - startY;
            const minW = 220,
                minH = 120;

            if (dir.includes("e")) {
                win.style.width = `${Math.max(minW, startWidth + dx)}px`;
            }
            if (dir.includes("s")) {
                win.style.height = `${Math.max(minH, startHeight + dy)}px`;
            }
            if (dir.includes("w")) {
                const newWidth = Math.max(minW, startWidth - dx);
                win.style.width = `${newWidth}px`;
                win.style.left = `${startLeft + (startWidth - newWidth)}px`;
            }
            if (dir.includes("n")) {
                const newHeight = Math.max(minH, startHeight - dy);
                win.style.height = `${newHeight}px`;
                win.style.top = `${startTop + (startHeight - newHeight)}px`;
            }
        });

        window.addEventListener("mouseup", () => {
            resizing = false;
            dir = "";
        });
    }

    document.querySelectorAll<HTMLElement>(".xp-window").forEach((win) => {
        initDrag(win);
        initResize(win);
    });
</script>
