---
export interface Props {
    items?: string[];
}
const { items = [] } = Astro.props;
---

<div
    class="flex gap-4 px-2 py-1 bg-[#ece9d8] border-b border-[#aca899] text-black"
>
    {
        items.map((m) => (
            <span class="hover:bg-[#3168d5] hover:text-white px-1 cursor-default">
                {m}
            </span>
        ))
    }
</div>
