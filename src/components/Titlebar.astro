---
export interface Props {
    title?: string;
}

const { title } = Astro.props;
---

<div
    class="xp-titlebar cursor-move flex items-center justify-between h-8 px-1 rounded-t-md"
    style="background: linear-gradient(to bottom, #0058ee 0%, #3593ff 8%, #0058ee 40%, #0050ee 90%, #003ccb 100%);"
>
    <div class="flex items-center gap-1.5 pl-1">
        <div
            class="w-4 h-4 bg-white/20 rounded-sm flex items-center justify-center"
        >
            <div
                class="w-3 h-3 rounded-sm border border-white/50"
                style="background: linear-gradient(135deg, #fde68a, #fb923c);"
            >
            </div>
        </div>
        <span
            class="text-white font-bold tracking-tight"
            style="text-shadow: 0 1px 1px rgba(0,0,0,0.5);"
        >
            {title}
        </span>
    </div>

    <div class="flex gap-0.5">
        <button
            class="w-5.25 h-5.25 border border-[#1030a0] rounded-[3px] text-white font-bold text-[11px] leading-none hover:brightness-110 active:brightness-90 flex items-center justify-center"
            style="background: linear-gradient(to bottom, #3980f6, #1550da);"
        >
            _
        </button>
        <button
            class="w-5.25 h-5.25 border border-[#1030a0] rounded-[3px] text-white font-bold text-[11px] leading-none hover:brightness-110 active:brightness-90 flex items-center justify-center"
            style="background: linear-gradient(to bottom, #3980f6, #1550da);"
        >
            □
        </button>
        <button
            class="w-5.25 h-5.25 border border-[#a01512] rounded-[3px] text-white font-bold text-[12px] leading-none hover:brightness-110 active:brightness-90 flex items-center justify-center"
            style="background: linear-gradient(to bottom, #f6a19f, #e0322d);"
        >
            ✕
        </button>
    </div>
</div>
