---
export interface Props {
    title?: string;
}

const { title } = Astro.props;
---

<div
    class="xp-titlebar
    cursor-default md:cursor-move
    flex items-center justify-between
    p-2 pt-3
    relative"
    style="
    background-image:
        linear-gradient(to right,
        rgba(255,255,255,0.15) 0%,
        rgba(255,255,255,0) 8%,
        rgba(0,0,0,0.15) 92%,
        rgba(0,0,0,0.2) 100%
        ),
        linear-gradient(
        to bottom,
        #0058ee 0%,
        #0058ee 5%,
        #4D9FE1 98%,
        #2178E0 100%
    );
    "
>
    <div
        class="pointer-events-none absolute inset-0 shadow-[inset_8px_0_10px_-4px_rgba(33,120,224,0.9),inset_-8px_0_10px_-4px_rgba(33,120,224,0.9)]"
    >
    </div>
    <div
        class="pointer-events-none absolute inset-0 inset-x-2"
        style="
        background-image: radial-gradient(ellipse 300% 3% at 100% 3%,
            rgba(255,255,255,0.9) 0%,
            rgba(255,255,255,0) 70%);
            mask-image: linear-gradient(to right,
                transparent 0%,
                white 4%,
                white 96%,
                transparent 100%);
            -webkit-mask-image: linear-gradient(to right,
                transparent 0%,
                white 4%,
                white 96%,
                transparent 100%);
        "
    >
    </div>
    <div class="flex items-center gap-1.5 pl-1">
        <div
            class="w-4 h-4 bg-white/20 rounded-sm flex items-center justify-center"
        >
            <div
                class="w-3 h-3 rounded-sm border border-white/50"
                style="background: linear-gradient(135deg, #fde68a, #fb923c);"
            >
            </div>
        </div>
        <span
            class="text-white font-bold tracking-tight"
            style="text-shadow: 0 1px 1px rgba(0,0,0,0.5);"
        >
            {title}
        </span>
    </div>
</div>
