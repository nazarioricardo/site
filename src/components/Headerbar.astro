---
import Profile from "./Profile.astro";
---

<div
    class="xp-titlebar cursor-move flex items-center justify-between p-2 pt-3"
    style="background: linear-gradient(to bottom, #0058ee 0%, #3593ff 8%, #0058ee 40%, #0050ee 90%, #003ccb 100%);"
>
    <div class="flex items-center gap-1.5">
        <Profile />

        <h1
            class="text-white text-3xl ml-2 tracking-tight"
            style="text-shadow: 0 1px 1px rgba(0,0,0,0.5);"
        >
            Ricardo Nazario
        </h1>
    </div>
</div>
